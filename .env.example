# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/valuemitra"

# ─────────────────────────────────────────────
# JWT / AUTH
# ─────────────────────────────────────────────
JWT_SECRET="change-this-to-a-64-character-random-string-before-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=30

# ─────────────────────────────────────────────
# AWS
# ─────────────────────────────────────────────
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="valuemitra-documents"
AWS_S3_TEMPLATES_PREFIX="templates/"
AWS_S3_REPORTS_PREFIX="reports/"
AWS_S3_UPLOADS_PREFIX="uploads/"

# ─────────────────────────────────────────────
# FILE STORAGE
# ─────────────────────────────────────────────
# "local" for development, "s3" for production
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_PATH="./uploads"
MAX_FILE_SIZE_MB=50

# ─────────────────────────────────────────────
# OCR
# ─────────────────────────────────────────────
# Google Cloud Vision API
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
# Azure Form Recognizer (fallback)
AZURE_FORM_RECOGNIZER_ENDPOINT=""
AZURE_FORM_RECOGNIZER_KEY=""

# ─────────────────────────────────────────────
# AI VALUATION (Claude API)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ─────────────────────────────────────────────
# EMAIL (AWS SES)
# ─────────────────────────────────────────────
SES_FROM_EMAIL="noreply@valuemitra.in"
SES_FROM_NAME="ValueMitra"
SES_REGION="ap-south-1"

# ─────────────────────────────────────────────
# REPORT GENERATION
# ─────────────────────────────────────────────
LIBREOFFICE_PATH="/usr/bin/libreoffice"
REPORT_TMP_DIR="/tmp/valuemitra-reports"

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3001"
# Unique worker ID when running multiple instances
WORKER_ID="worker-1"
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
