# ValueMitra v2 — copy to .env at the repo root. Relative paths are relative to the repo root.
NODE_ENV=development
PORT=3010
APP_URL=http://localhost:5173          # public URL of the web app (used in engineer links)
API_URL=http://localhost:3010

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=valuemitra
DB_USER=
DB_PASSWORD=

# secrets: generate each with `openssl rand -hex 32`
JWT_SECRET=
LINK_SECRET=
ENCRYPTION_KEY=                         # 64 hex chars (AES-256 key for TOTP secrets)
REQUIRE_2FA=true                        # valuers and admins must use an authenticator app

STORAGE_DIR=./storage                   # firm-scoped file storage

# document reading
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-vision.json
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# optional: road + satellite maps (otherwise OpenStreetMap road map)
GOOGLE_MAPS_API_KEY=

# outgoing email (report dispatch)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=

# PDF tools
SOFFICE_PATH=soffice
PDFTOPPM_PATH=pdftoppm
