# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/valuemitra"

# ─────────────────────────────────────────────
# JWT / AUTH
# ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_STRING"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=30

# ─────────────────────────────────────────────
# AWS
# ─────────────────────────────────────────────
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="valuemitra-documents"
AWS_S3_TEMPLATES_PREFIX="templates/"
AWS_S3_REPORTS_PREFIX="reports/"
AWS_S3_UPLOADS_PREFIX="uploads/"

# ─────────────────────────────────────────────
# FILE STORAGE
# ─────────────────────────────────────────────
# Use "local" if no S3 bucket yet, "s3" in production
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_PATH="./uploads"
MAX_FILE_SIZE_MB=50

# ─────────────────────────────────────────────
# OCR
# ─────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS="/var/www/valuemitra/valuemitra-ocr-keys.json"
AZURE_FORM_RECOGNIZER_ENDPOINT=""
AZURE_FORM_RECOGNIZER_KEY=""

# ─────────────────────────────────────────────
# AI VALUATION (Claude API)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ─────────────────────────────────────────────
# EMAIL (AWS SES SMTP)
# ─────────────────────────────────────────────
SES_SMTP_HOST="email-smtp.ap-south-1.amazonaws.com"
SES_SMTP_PORT=587
SES_SMTP_USER="REPLACE_WITH_SES_SMTP_USER"
SES_SMTP_PASS="REPLACE_WITH_SES_SMTP_PASS"
EMAIL_SENDER="no-response@valuemitra.com"
EMAIL_SENDER_NAME="Valuemitra"
EMAIL_BCC="mehul.pipalia@gmail.com"

# ─────────────────────────────────────────────
# REPORT GENERATION
# ─────────────────────────────────────────────
# LibreOffice path on Ubuntu: /usr/bin/soffice
LIBREOFFICE_PATH="/usr/bin/soffice"
REPORT_TMP_DIR="/tmp/valuemitra-reports"

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NODE_ENV="production"
PORT=3006
FRONTEND_URL="https://vmapps.techsahyogi.com"
API_URL="https://vmapps.techsahyogi.com"
WORKER_ID="worker-1"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
