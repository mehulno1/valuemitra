    "@prisma/client": "^5.19.1",
    "@types/nodemailer": "^7.0.11",
    "@valuemitra/shared": "*",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "docxtemplater": "^3.49.0",
    "docxtemplater-image-module-free": "^1.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
