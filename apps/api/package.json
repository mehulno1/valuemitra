{
  "name": "@vm/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/seed/index.ts",
    "db:reset": "tsx --env-file=../../.env src/db/migrate.ts --reset && tsx --env-file=../../.env src/seed/index.ts",
    "db:types": "sh scripts/db-types.sh",
    "firm:create": "tsx --env-file=../../.env src/seed/create-firm.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@xmldom/xmldom": "0.9.12",
    "bcryptjs": "3.0.3",
    "docx": "9.13.0",
    "docxtemplater": "3.71.1",
    "docxtemplater-image-module-free": "1.1.1",
    "exifr": "7.1.3",
    "fastify": "5.12.7",
    "google-auth-library": "11.3.1",
    "jose": "6.2.13",
    "kysely": "0.29.7",
    "mysql2": "3.24.6",
    "node-cron": "4.6.0",
    "nodemailer": "10.1.7",
    "otplib": "13.5.0",
    "pdf-lib": "1.17.1",
    "pizzip": "3.3.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "26.6.5",
    "@types/node-cron": "3.0.11",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "kysely-codegen": "0.20.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
