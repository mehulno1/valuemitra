generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// MULTI-TENANCY
// ─────────────────────────────────────────────

model Tenant {
  id                String    @id @default(uuid())
  name              String    @db.VarChar(200)
  slug              String    @unique @db.VarChar(100)
  firmCode          String    @db.VarChar(10)            // Used in ref nos: UCVLLP/PNB/2025-26/001
  gstin             String?   @db.VarChar(15)
  pan               String?   @db.VarChar(10)
  registeredAddress String    @db.Text
  city              String    @db.VarChar(100)
  state             String    @db.VarChar(100)
  pincode           String    @db.VarChar(6)
  phone             String    @db.VarChar(15)
  email             String    @db.VarChar(200)
  logoUrl           String?   @db.VarChar(500)
  ibbiFirmRegNo     String?   @db.VarChar(100)
  rvoName           String?   @db.VarChar(200)
  planId            String    @default("trial") @db.VarChar(50)
  planExpiresAt     DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users             User[]
  assignments       Assignment[]
  clients           Client[]
  properties        Property[]
  inspections       Inspection[]
  governmentRates   GovernmentRate[]
  reportTemplates   ReportTemplate[]
  auditLogs         AuditLog[]
  cacheEntries      CacheEntry[]
  notifications     Notification[]

  @@index([slug])
  @@index([isActive])
  @@map("tenants")
}

// ─────────────────────────────────────────────
// USERS & AUTHENTICATION
// ─────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  email             String    @db.VarChar(200)
  passwordHash      String    @db.VarChar(255)
  fullName          String    @db.VarChar(200)
  phone             String?   @db.VarChar(15)
  role              String    @default("VALUER") @db.VarChar(20)   // UserRole enum
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?

  // IBBI compliance — mandatory before report generation
  ibbiRegNo         String?   @db.VarChar(100)
  ibbiRegCategory   String?   @db.VarChar(100)    // "Land & Building" / "Plant & Machinery" / "Securities"
  ibbiRegValidUpto  DateTime?
  rvoMembershipNo   String?   @db.VarChar(100)
  qualifications    String?   @db.Text
  experienceYears   Int?
  signatureUrl      String?   @db.VarChar(500)    // S3 key to RV signature image
  stampUrl          String?   @db.VarChar(500)    // S3 key to RV stamp/seal image

  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  refreshTokens           RefreshToken[]
  assignmentsCreated      Assignment[]      @relation("CreatedBy")
  assignmentsAssigned     Assignment[]      @relation("AssignedTo")
  auditLogs               AuditLog[]
  documents               Document[]
  passwordResetTokens     PasswordResetToken[]
  inspections             Inspection[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([ibbiRegNo])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @db.VarChar(255)    // SHA-256 hash of the opaque token
  expiresAt   DateTime
  isRevoked   Boolean   @default(false)
  deviceInfo  String?   @db.VarChar(255)
  ipAddress   String?   @db.VarChar(45)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @db.VarChar(255)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// CLIENTS & BANKS
// ─────────────────────────────────────────────

model Client {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  clientType    String    @default("INDIVIDUAL") @db.VarChar(20)  // ClientType enum
  fullName      String?   @db.VarChar(200)
  pan           String?   @db.VarChar(10)
  aadhaarLast4  String?   @db.VarChar(4)
  companyName   String?   @db.VarChar(200)
  cin           String?   @db.VarChar(21)
  gstin         String?   @db.VarChar(15)
  email         String?   @db.VarChar(200)
  phone         String?   @db.VarChar(15)
  address       String?   @db.Text
  city          String?   @db.VarChar(100)
  state         String?   @db.VarChar(100)
  pincode       String?   @db.VarChar(6)
  isBank        Boolean   @default(false)
  bankName      String?   @db.VarChar(200)
  bankCode      String?   @db.VarChar(20)    // BankCode enum
  bankBranch    String?   @db.VarChar(200)
  ifscCode      String?   @db.VarChar(11)
  loanAccountNo String?   @db.VarChar(50)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignments   Assignment[]

  @@index([tenantId])
  @@index([tenantId, isBank])
  @@map("clients")
}

// ─────────────────────────────────────────────
// ASSIGNMENTS (core workflow unit)
// ─────────────────────────────────────────────

model Assignment {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  assignmentNo        String    @db.VarChar(50)    // VM/2024-25/0001
  firmReferenceNo     String    @db.VarChar(100)   // UCVLLP/PNB/2025-26/0001
  clientId            String
  client              Client    @relation(fields: [clientId], references: [id])
  createdById         String
  createdBy           User      @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId        String?
  assignedTo          User?     @relation("AssignedTo", fields: [assignedToId], references: [id])

  // Classification
  purposeOfValuation  String    @default("MORTGAGE") @db.VarChar(50)   // ValuationPurpose enum
  propertyType        String    @default("RESIDENTIAL_FLAT") @db.VarChar(50)  // PropertyType enum
  status              String    @default("INITIATED") @db.VarChar(50)  // AssignmentStatus enum

  // Fresh / Revaluation
  freshOrRevaluation  String?   @db.VarChar(20)    // "Fresh" | "Revaluation" | "Review"

  // DOC_020: Previous valuation report details (populated when freshOrRevaluation = "Revaluation")
  prevReportRefNo     String?   @db.VarChar(100)   // DOC_020a: Previous report reference number
  prevValuerName      String?   @db.VarChar(200)   // DOC_020b: Previous valuer's name
  prevReportDate      DateTime?                     // DOC_020c: Previous report date

  // Under-construction
  isUnderConstruction Boolean   @default(false)
  percentageCompletion Int?
  expectedHandoverDate DateTime?

  // Key dates (IBBI compliance)
  inspectionDate      DateTime?
  reportDate          DateTime?
  submittedAt         DateTime?

  // Fee
  agreedFee           Decimal?  @db.Decimal(12, 2)
  feeGst              Decimal?  @db.Decimal(12, 2)
  feePaidAt           DateTime?

  // GEN_006: Bank branch for this specific assignment (may differ from Client.bankBranch)
  bankBranchAddress   String?   @db.VarChar(300)
  // GEN_007: Bank relationship manager / contact
  bankRepresentative  String?   @db.VarChar(200)

  // INS_001: Loan / Assignment Type (drives doc requirements & valuation approach)
  loanType            String?   @db.VarChar(50)   // Builder/Resale/Top-up/Balance Transfer/HEHL/LAP/APF
  // INS_002: Detailed property sub-type within the 6 main categories
  propertySubType     String?   @db.VarChar(100)  // Flat/Bungalow/Row House/Duplex/Shop/Godown/Office/Industrial/Open Land

  // Bank reference
  bankRefNo           String?   @db.VarChar(100)
  bankInstructionDate DateTime?

  // Result summary
  finalValue          Decimal?  @db.Decimal(15, 2)
  valuationCurrency   String    @default("INR") @db.VarChar(3)

  referenceNote       String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  property        Property?
  inspection      Inspection?
  documents       Document[]
  valuationRuns   ValuationRun[]
  reports         Report[]
  checklist       ChecklistItem[]
  notifications   Notification[]

  @@unique([tenantId, assignmentNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([clientId])
  @@index([assignedToId])
  @@map("assignments")
}

// ─────────────────────────────────────────────
// PROPERTY (subject property details)
// ─────────────────────────────────────────────

model Property {
  id                    String    @id @default(uuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  assignmentId          String    @unique
  assignment            Assignment @relation(fields: [assignmentId], references: [id])

  // Location
  addressLine1          String?   @db.VarChar(300)
  addressLine2          String?   @db.VarChar(300)
  city                  String?   @db.VarChar(100)
  district              String?   @db.VarChar(100)
  taluka                String?   @db.VarChar(100)    // LOC_010: Taluka/Ward
  village               String?   @db.VarChar(100)    // LOC_009: Village/Locality
  state                 String?   @db.VarChar(100)
  pincode               String?   @db.VarChar(6)
  landmark              String?   @db.VarChar(200)    // LOC_015
  municipalCorporation  String?   @db.VarChar(100)    // LOC_016: MCGM/Panchayat
  latitude              Decimal?  @db.Decimal(10, 8)
  longitude             Decimal?  @db.Decimal(11, 8)

  // Revenue/Survey identification
  surveyNo              String?   @db.VarChar(100)
  hissaNo               String?   @db.VarChar(50)     // LOC_002: Hissa/sub-division
  ctsSurveyNo           String?   @db.VarChar(100)
  municipalNo           String?   @db.VarChar(100)
  societyName           String?   @db.VarChar(200)
  flatNo                String?   @db.VarChar(50)
  floor                 Int?
  wingName              String?   @db.VarChar(100)    // LOC_006: Wing/Tower/Block
  buildingName          String?   @db.VarChar(200)

  // Land details
  landAreaSqM           Decimal?  @db.Decimal(12, 4)
  landAreaSqFt          Decimal?  @db.Decimal(12, 4)
  landAreaAcre          Decimal?  @db.Decimal(10, 6)
  landAreaHectare       Decimal?  @db.Decimal(10, 6)
  landTenure            String?   @db.VarChar(30)    // LandTenure enum
  leaseExpiryDate       DateTime?
  zoningClassification  String?   @db.VarChar(100)

  // LND_009: Leasehold tenure details for land (expands leaseExpiryDate)
  leaseLessorName       String?   @db.VarChar(200)   // LND_009a: Name of lessor/authority
  leasePeriodYears      Int?                          // LND_009b: Original lease period (years)
  leaseStartDate        DateTime?                     // LND_009c: Lease commencement date

  // LND_010–011: Open land planning flags
  agriculturalConversionContemplated Boolean?         // LND_010: Ag conversion contemplated Y/N
  tpApprovedLayout      Boolean?                      // LND_011: Town planning approved layout Y/N

  // Adopted land area (MIN rule: MIN(doc,actual) — stored for IBBI audit trail)
  adoptedLandAreaSqM    Decimal?  @db.Decimal(12, 4) // Computed: MIN(landAreaSqM, landAreaActualSqM)
  adoptedLandAreaSqFt   Decimal?  @db.Decimal(12, 4)

  // LOC_008: Street / Road name
  streetName            String?   @db.VarChar(200)

  // Ownership (from title deed / OCR)
  ownerNames            Json?
  ownerAddress          String?   @db.Text            // OWN_002: Owner correspondence address
  ownerContact          String?   @db.VarChar(15)     // OWN_003: Owner contact number
  ownerPan              String?   @db.VarChar(10)     // OWN_004: Owner PAN (required by BOB Office)
  ownershipNature       String?   @db.VarChar(30)     // OWN_005: Individual/Joint/Company/HUF/Partnership
  ownerShareDetails     String?   @db.VarChar(500)    // OWN_006: e.g. "50% each"
  borrowerName          String?   @db.VarChar(200)    // OWN_007: Applicant/Borrower (may differ from owner)
  developerName         String?   @db.VarChar(200)    // OWN_008: Builder/Developer (UC/L&B)
  reraNo                String?   @db.VarChar(100)    // DOC_008: RERA registration

  // Proposed purchaser (UC flat — required by several banks)
  proposedPurchaserName    String?   @db.VarChar(200) // UC-specific: name of proposed buyer
  proposedPurchaserAddress String?   @db.Text         // UC-specific: address of proposed buyer

  // BLDG_006: Building completion status (dropdown)
  buildingCompletionStatus String? @db.VarChar(30)  // FULLY_COMPLETED/PARTIALLY_COMPLETED/UNDER_CONSTRUCTION

  // BLDA_005: External Development Area (compound wall, paving, gate, security cabin)
  externalDevAreaSqM    Decimal?  @db.Decimal(12, 4)
  externalDevAreaSqFt   Decimal?  @db.Decimal(12, 4)
  // BLDA_006: Industrial Structures / Sheds / Outbuildings
  industrialStructures  String?   @db.Text

  // SITE_011 / ANN_004: Google Maps / Location screenshot URL
  locationMapUrl        String?   @db.VarChar(500)

  // Building details — document values
  builtUpAreaSqM        Decimal?  @db.Decimal(12, 4)
  builtUpAreaSqFt       Decimal?  @db.Decimal(12, 4)
  carpetAreaSqM         Decimal?  @db.Decimal(12, 4)
  carpetAreaSqFt        Decimal?  @db.Decimal(12, 4)
  superBuiltUpAreaSqM   Decimal?  @db.Decimal(12, 4)  // UNIT_005: Saleable area
  superBuiltUpAreaSqFt  Decimal?  @db.Decimal(12, 4)
  unitConfiguration     String?   @db.VarChar(100)    // UNIT_006: "2BHK+2T", "Shop with mezzanine"
  numberOfFloors        Int?
  yearOfConstruction    Int?
  ageOfBuilding         Int?
  remainingLifeYears    Int?                          // BLDG_003: computed/override

  // Actual site-measured areas (vs document values)
  builtUpAreaActualSqM  Decimal?  @db.Decimal(12, 4)  // UNIT_004: site-measured
  builtUpAreaActualSqFt Decimal?  @db.Decimal(12, 4)
  carpetAreaActualSqM   Decimal?  @db.Decimal(12, 4)  // UNIT_002: site-measured
  carpetAreaActualSqFt  Decimal?  @db.Decimal(12, 4)
  landAreaActualSqM     Decimal?  @db.Decimal(12, 4)  // LND_002: actual vs doc
  landAreaActualSqFt    Decimal?  @db.Decimal(12, 4)

  // UDS + land details (Flat/Land/L&B)
  udsArea               Decimal?  @db.Decimal(12, 4)  // LND_003: Undivided Share of Land
  udsUnit               String?   @db.VarChar(10)     // Sq.Ft / Sq.M / fraction
  dpZone                String?   @db.VarChar(100)    // LND_004: DP Zone
  fsi                   Decimal?  @db.Decimal(5, 2)   // LND_005: FSI / FAR
  permissibleUse        String?   @db.VarChar(200)    // LND_006
  naOrderDetails        String?   @db.VarChar(300)    // LND_007: NA Order no/date/authority
  miDcPlotNo            String?   @db.VarChar(50)     // LND_008: MIDC plot no

  // Additional building compliance (Batch 2)
  approvedPlanValidity  DateTime?                     // BLDG_009b: plan validity date
  planGenuinenessVerified Boolean?                    // BLDG_010

  // Building floors breakdown (L&B only)
  // Array: [{floorLabel, useType, builtUpAreaSqM, builtUpAreaSqFt, remarks}]
  buildingFloors        Json?

  // PHY_013–016: Site infrastructure (Open Land / L&B specific)
  plotPosition          String?   @db.VarChar(30)    // PHY_013: Corner/Intermittent/Through/End
  waterPotentiality     String?   @db.VarChar(50)    // PHY_014: Municipal/Borewell/Nil/Unknown
  undergroundSewerage   String?   @db.VarChar(50)    // PHY_015: UGD/Septic/None
  powerSupply           String?   @db.VarChar(100)   // PHY_016: MSEDCL/DGVCL/DG Set/None

  // BLDG_017: Foundation type
  foundationType        String?   @db.VarChar(50)    // Strip/Raft/Pile/Isolated/N/A

  // AREA_006: CRZ / coastal applicability
  czrApplicable         Boolean?                      // AREA_006: CRZ zone applicable Y/N
  distanceFromSeaM      Decimal?  @db.Decimal(10, 2) // AREA_006: Distance from sea/CRZ boundary (metres)

  // Structure/condition
  structureType         String?   @db.VarChar(100)
  roofType              String?   @db.VarChar(100)
  exteriorCondition     String?   @db.VarChar(50)
  interiorCondition     String?   @db.VarChar(50)

  // Legal document references (extracted by Claude from OCR text)
  registrationNo        String?   @db.VarChar(100)
  registrationDate      DateTime?
  indexIINo             String?   @db.VarChar(100)
  agreementValue        Decimal?  @db.Decimal(15, 2)
  stampDutyPaid         Decimal?  @db.Decimal(15, 2)
  occupancyCertificateNo String?  @db.VarChar(100)
  approvedPlanNo        String?   @db.VarChar(100)
  sharesCertificateNo   String?   @db.VarChar(100)

  // Building compliance flags (IBBI + bank requirements)
  approvedPlanAuthority String?   @db.VarChar(100)    // BLDG_008: MCGM/NMMC/CIDCO/Gram Panchayat
  approvedPlanDate      DateTime?                     // BLDG_009
  unauthorizedConstruction       Boolean?             // BLDG_011: critical compliance flag ⚠️
  unauthorizedConstructionNotes  String?   @db.Text
  demolitionProceedings          Boolean?             // BLDG_012: PNB requirement
  demolitionProceedingsNotes     String?   @db.Text

  // Area classification (AREA group — as JSON for flexibility)
  // Keys: type, highMiddlePoor, urbanRural, corpType, govtEnactments, czrNote
  areaClassification    Json?

  // Physical / site description (PHY group — as JSON)
  // Keys: landNature, landLayout, plotShape, directAccess, accessMode,
  //       boundaryNature, demarcated, possession, tenancyNature, crops, otherDev
  physicalDetails       Json?

  // Boundary details (BND group — as JSON)
  // Keys: northDoc, southDoc, eastDoc, westDoc, northActual, southActual, eastActual, westActual
  boundaryDetails       Json?

  // Missing documents (array of DocumentType strings, for report remarks)
  missingDocuments      Json?

  // Data verification
  dataVerifiedAt        DateTime?
  dataVerifiedById      String?

  // Flexible OCR-extracted data (JSON — legacy, kept for backward compat)
  extractedData         Json?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([tenantId])
  @@index([state, district])
  @@map("properties")
}

// ─────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────

model Document {
  id              String    @id @default(uuid())
  tenantId        String
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id])
  uploadedById    String
  uploadedBy      User      @relation(fields: [uploadedById], references: [id])

  // File metadata
  originalName    String    @db.VarChar(300)
  storagePath     String    @db.VarChar(500)
  storageProvider String    @default("local") @db.VarChar(20)  // "local" | "s3"
  mimeType        String    @db.VarChar(100)
  fileSizeBytes   Int
  checksum        String?   @db.VarChar(64)

  // Classification
  documentType    String    @db.VarChar(50)    // DocumentType enum
  subType         String?   @db.VarChar(100)
  // INS_051–062: Photo category for inspection photos (PhotoCategory enum)
  photoCategory   String?   @db.VarChar(50)

  // OCR processing
  ocrStatus       String    @default("PENDING") @db.VarChar(20)  // OCRStatus enum
  ocrJobId        String?   @db.VarChar(100)
  ocrProvider     String?   @db.VarChar(50)
  ocrRawResponse  Json?
  ocrExtracted    Json?
  ocrConfidence   Decimal?  @db.Decimal(5, 4)
  ocrReviewedAt   DateTime?
  ocrReviewedById String?

  // Versioning & soft delete
  version         Int       @default(1)
  replacedById    String?
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([assignmentId])
  @@index([tenantId])
  @@index([ocrStatus])
  @@index([documentType])
  @@map("documents")
}

// ─────────────────────────────────────────────
// DOCUMENT CHECKLIST
// ─────────────────────────────────────────────

model ChecklistItem {
  id              String    @id @default(uuid())
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id])
  documentType    String    @db.VarChar(50)    // DocumentType enum
  label           String    @db.VarChar(200)
  isMandatory     Boolean   @default(false)
  status          String    @default("PENDING") @db.VarChar(20)  // ChecklistStatus enum
  documentId      String?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([assignmentId])
  @@map("checklist_items")
}

// ─────────────────────────────────────────────
// GOVERNMENT RATES
// ─────────────────────────────────────────────

model GovernmentRate {
  id              String    @id @default(uuid())
  tenantId        String?                                      // NULL = platform-level (visible to all)
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
  state           String    @db.VarChar(50)
  rateYear        String    @db.VarChar(10)                   // "2024-25"
  district        String?   @db.VarChar(100)
  taluka          String?   @db.VarChar(100)
  village         String?   @db.VarChar(100)
  zone            String?   @db.VarChar(50)
  jantriZone      String?   @db.VarChar(100)
  surveyType      String?   @db.VarChar(50)
  propertyCategory String   @db.VarChar(100)                  // RateCategory enum
  ratePerSqM      Decimal?  @db.Decimal(12, 2)
  ratePerSqFt     Decimal?  @db.Decimal(12, 2)
  ratePerAcre     Decimal?  @db.Decimal(15, 2)
  sourceUrl       String?   @db.VarChar(500)
  fetchedAt       DateTime
  isManualOverride Boolean  @default(false)
  overrideNotes   String?   @db.Text
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([state, rateYear, district, taluka])
  @@index([isActive])
  @@map("government_rates")
}

// ─────────────────────────────────────────────
// VALUATION COMPUTATION ENGINE
// ─────────────────────────────────────────────

model ValuationRun {
  id                    String    @id @default(uuid())
  assignmentId          String
  assignment            Assignment @relation(fields: [assignmentId], references: [id])
  approach              String    @db.VarChar(30)    // ValuationApproach enum
  version               Int       @default(1)
  isFinalized           Boolean   @default(false)

  // Market Comparison
  comparables           Json?     // Array of ComparableSale objects
  adjustmentFactors     Json?
  adjustedValues        Json?
  correlatedValue       Decimal?  @db.Decimal(15, 2)

  // Cost Approach — Land
  landValue             Decimal?  @db.Decimal(15, 2)
  landRateUsed          Decimal?  @db.Decimal(12, 2)
  landRateSource        String?   @db.VarChar(50)
  landGovtRateId        String?

  // Cost Approach — Building
  buildingPlinthArea    Decimal?  @db.Decimal(12, 4)
  buildingRatePerSqM    Decimal?  @db.Decimal(10, 2)
  replacementCost       Decimal?  @db.Decimal(15, 2)
  depreciationMethod    String?   @db.VarChar(30)    // DepreciationMethod enum
  depreciationRate      Decimal?  @db.Decimal(6, 4)
  depreciationAmount    Decimal?  @db.Decimal(15, 2)
  depreciatedValue      Decimal?  @db.Decimal(15, 2)
  servicesCost          Decimal?  @db.Decimal(15, 2)
  costApproachValue     Decimal?  @db.Decimal(15, 2)

  // Income Approach
  grossRent             Decimal?  @db.Decimal(12, 2)
  vacancyRate           Decimal?  @db.Decimal(6, 4)
  effectiveGrossIncome  Decimal?  @db.Decimal(15, 2)
  operatingExpenses     Decimal?  @db.Decimal(15, 2)
  netOperatingIncome    Decimal?  @db.Decimal(15, 2)
  capitalizationRate    Decimal?  @db.Decimal(6, 4)
  incomeApproachValue   Decimal?  @db.Decimal(15, 2)

  // AI Valuation Model output
  aiValuationResult     Json?     // AIValuationResult object

  // Final Reconciliation
  marketApproachWeight  Decimal?  @db.Decimal(5, 4)
  costApproachWeight    Decimal?  @db.Decimal(5, 4)
  incomeApproachWeight  Decimal?  @db.Decimal(5, 4)
  weightedValue         Decimal?  @db.Decimal(15, 2)
  roundedValue          Decimal?  @db.Decimal(15, 2)   // Final adopted value

  reconciliationNotes   String?   @db.Text

  // Market analysis & marketability (MKT_009-012)
  marketabilityRating   String?   @db.VarChar(20)    // Good/Average/Poor/Low
  positiveFactors       String?   @db.Text           // MKT_010: Canara "favourable factors"
  negativeFactors       String?   @db.Text           // MKT_011: Canara "negative factors"
  marketAnalysisNarrative String? @db.Text           // MKT_012: AI-drafted + RV edits

  // Government RR / Jantri rate inputs (VAL_002, VAL_004)
  rrRatePerSqM          Decimal?  @db.Decimal(12, 2) // VAL_002: Govt RR/Jantri rate per sq.m. (land)
  rrRatePerSqFt         Decimal?  @db.Decimal(12, 2) // VAL_002: Govt RR/Jantri rate per sq.ft. (land)
  rrRateYear            String?   @db.VarChar(10)    // VAL_004: e.g. "2025-26"
  rrScreenshotUrl       String?   @db.VarChar(500)   // VAL_003: time-stamped RR screenshot
  // L&B only: separate RR rate for building component (RR has distinct land + construction rates)
  rrBuildingRatePerSqM  Decimal?  @db.Decimal(12, 2) // L&B building RR rate per sq.m.
  rrBuildingRatePerSqFt Decimal?  @db.Decimal(12, 2) // L&B building RR rate per sq.ft.

  // Derived value outputs (stored explicitly for display + report)
  externalDevelopmentValue Decimal? @db.Decimal(15, 2) // VAL_011: compound wall, paving, gate
  realizableValue       Decimal?  @db.Decimal(15, 2) // VAL_013: typically 90% of FMV
  distressValue         Decimal?  @db.Decimal(15, 2) // VAL_014: typically 80% of FMV
  govtGuidelineValue    Decimal?  @db.Decimal(15, 2) // VAL_015: Area × RR/Jantri rate

  // Bank-specific outputs (populated where template requires them)
  compositeRatePerSqFt  Decimal?  @db.Decimal(12, 2) // VAL_006: auto-computed or overridden
  insuranceValue        Decimal?  @db.Decimal(15, 2) // VAL_016: SBI/BOM
  rentalValueMonthly    Decimal?  @db.Decimal(12, 2) // VAL_017: Canara/SBI
  bookValue             Decimal?  @db.Decimal(15, 2) // VAL_018: BOM UC / SBI L&B
  stageDiscountPct      Decimal?  @db.Decimal(5, 2)  // VAL_019: UC additional stage discount % (beyond completion %)

  // IBBI audit snapshot — immutable record of all inputs at computation time
  inputSnapshot         Json?

  computedAt            DateTime?
  computedById          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([assignmentId])
  @@map("valuation_runs")
}

// ─────────────────────────────────────────────
// REPORT GENERATION ENGINE
// ─────────────────────────────────────────────

model ReportTemplate {
  id                String    @id @default(uuid())
  tenantId          String?                                    // NULL = platform template
  tenant            Tenant?   @relation(fields: [tenantId], references: [id])
  name              String    @db.VarChar(200)
  bankName          String    @db.VarChar(200)
  bankCode          String    @db.VarChar(20)    // BankCode enum
  propertyType      String    @db.VarChar(50)    // PropertyType enum
  isUnderConstruction Boolean @default(false)
  version           String    @db.VarChar(20)
  templateFilePath  String    @db.VarChar(500)   // S3 key to processed .docx
  fieldMappings     Json                          // ReportFieldMappings
  requiredFields    Json?                         // Array of required field names

  // Bank-specific conditional logic flags
  realizableValuePct    Decimal   @default(0.90) @db.Decimal(4, 2)  // BOI/UBI=0.95, others=0.90
  showDualStageValuation Boolean  @default(false)   // BOI/UBI UC: show both 100% + current stage value
  showInsuranceValue    Boolean   @default(false)   // SBI, BOM templates
  showBookValue         Boolean   @default(false)   // BOM UC, SBI L&B, UBI UC
  showRentalValue       Boolean   @default(false)   // Canara, SBI
  showPurchasePrice     Boolean   @default(false)   // BOI UC, UBI UC

  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reports           Report[]

  @@index([bankCode, propertyType])
  @@map("report_templates")
}

model Report {
  id              String    @id @default(uuid())
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id])
  templateId      String
  template        ReportTemplate @relation(fields: [templateId], references: [id])
  valuationRunId  String?
  status          String    @default("DRAFT") @db.VarChar(20)  // ReportStatus enum
  docxPath        String?   @db.VarChar(500)
  pdfPath         String?   @db.VarChar(500)
  reportData      Json                            // Complete ReportData snapshot
  signedAt        DateTime?
  signedById      String?
  signedAtPlace   String?   @db.VarChar(100)  // CERT_004: place of signing
  digitalSignature String?  @db.Text
  version         Int       @default(1)
  isLatest        Boolean   @default(true)
  generatedAt     DateTime?
  deliveredAt     DateTime?
  deliveredToEmail String?  @db.VarChar(200)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([assignmentId])
  @@map("reports")
}

// ─────────────────────────────────────────────
// AUDIT TRAIL (IBBI Compliance — NEVER deleted)
// ─────────────────────────────────────────────

model AuditLog {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  action      String    @db.VarChar(100)    // "assignment.status_changed", "report.generated", etc.
  entityType  String    @db.VarChar(50)
  entityId    String    @db.VarChar(36)
  before      Json?
  after       Json?
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())     // Immutable — no updatedAt

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  assignmentId    String?
  assignment      Assignment? @relation(fields: [assignmentId], references: [id])
  recipientEmail  String    @db.VarChar(200)
  recipientName   String?   @db.VarChar(200)
  channel         String    @default("EMAIL") @db.VarChar(20)
  type            String    @db.VarChar(100)   // e.g. "assignment.status_changed"
  subject         String    @db.VarChar(300)
  body            String    @db.Text
  status          String    @default("PENDING") @db.VarChar(20)
  sentAt          DateTime?
  failureReason   String?   @db.Text
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([status])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// CACHING (replaces Redis)
// ─────────────────────────────────────────────

model CacheEntry {
  id          String    @id @default(uuid())
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  cacheKey    String    @unique @db.VarChar(300)
  value       Json
  expiresAt   DateTime
  tags        String?   @db.VarChar(500)   // Comma-separated for group invalidation
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([expiresAt])
  @@index([tenantId])
  @@map("cache_entries")
}

// ─────────────────────────────────────────────
// BACKGROUND JOBS (replaces Bull/Redis)
// ─────────────────────────────────────────────

model JobQueue {
  id          String    @id @default(uuid())
  jobType     String    @db.VarChar(50)    // JobType enum
  payload     Json
  status      String    @default("PENDING") @db.VarChar(20)  // JobStatus enum
  priority    Int       @default(5)         // 1 (high) to 10 (low)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lockedAt    DateTime?
  lockedBy    String?   @db.VarChar(100)   // Worker instance ID
  failureLog  Json?                         // Array of error records
  scheduledAt DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, priority, scheduledAt])
  @@index([jobType, status])
  @@map("job_queue")
}

// ─────────────────────────────────────────────
// INSPECTION (Phase B — site visit by inspector)
// ─────────────────────────────────────────────

model Inspection {
  id                         String    @id @default(uuid())
  tenantId                   String
  tenant                     Tenant    @relation(fields: [tenantId], references: [id])
  assignmentId               String    @unique
  assignment                 Assignment @relation(fields: [assignmentId], references: [id])
  inspectorId                String
  inspector                  User      @relation(fields: [inspectorId], references: [id])

  // Schedule
  scheduledDate              DateTime?

  // Site visit details
  inspectionDate             DateTime?
  propertyShownBy            String?   @db.VarChar(200)   // SITE_001
  propertyShownByPhone       String?   @db.VarChar(15)    // SITE_002
  propertyShownByDesignation String?   @db.VarChar(100)   // SITE_003: relationship with owner

  // Occupancy
  occupancyStatus            String?   @db.VarChar(30)   // SITE_004: SELF_OCCUPIED/TENANTED/VACANT/PARTIALLY_VACANT
  occupantName               String?   @db.VarChar(200)  // SITE_005: name of occupant if tenant
  occupantRelation           String?   @db.VarChar(100)  // SITE_006: relation with owner
  occupiedSince              String?   @db.VarChar(50)   // SITE_007: date/year of occupation

  // Flat identification
  flatNumberDisplayed        Boolean?
  flatNumberAsDisplayed      String?   @db.VarChar(50)   // SITE_008: name on door/entrance
  nameOnBoard                String?   @db.VarChar(200)  // SITE_009: Society/building board name

  // INS_003–008: Connectivity / distances
  nearestStationName         String?   @db.VarChar(200)  // INS_003
  distanceFromStationKm      Decimal?  @db.Decimal(5, 2) // INS_004
  nearestBusStopName         String?   @db.VarChar(200)  // INS_005
  distanceFromBusStopKm      Decimal?  @db.Decimal(5, 2) // INS_006
  distanceFromSchoolKm       Decimal?  @db.Decimal(5, 2) // INS_007
  distanceFromHospitalKm     Decimal?  @db.Decimal(5, 2) // INS_008

  // INS_009–013: Building characteristics
  groundFloorType            String?   @db.VarChar(50)   // INS_009: Ground/Stilt/Basement/Podium/Stilt+Podium
  storeyHeightFt             Decimal?  @db.Decimal(5, 2) // INS_010: floor-to-floor height
  flatsPerFloor              Int?                        // INS_011
  numberOfWings              Int?                        // INS_012
  numberOfLifts              Int?                        // INS_013

  // INS_014: Compound wall & gate (replaces Boolean boundaryWall)
  compoundWallGateType       String?   @db.VarChar(100)  // RCC Wall+Iron Gate/Iron Fencing/Brick Wall/No Compound

  // Construction & condition
  constructionQuality        String?   @db.VarChar(20)   // GOOD/AVERAGE/POOR
  maintenanceCondition       String?   @db.VarChar(20)   // BLDG_016

  // Amenities (JSON: { gym, club, pool, garden, security, intercom, generator, solarPower })
  amenities                  Json?

  // Unit finishes (INS_015–027)
  flooringType               String?   @db.VarChar(100)  // INS_015 / UNIT_007: unit interior flooring
  flooringExternal           String?   @db.VarChar(100)  // INS_016: around building (CC/Paving/Kota/None)
  flooringStaircase          String?   @db.VarChar(100)  // INS_017: staircase & lobby
  flooringLobby              String?   @db.VarChar(100)  // INS_018: building main entrance lobby
  waterSupplyType            String?   @db.VarChar(100)  // INS_019: Direct Municipal/UG Tank/OH Tank/Borewell
  waterSupplyQuality         String?   @db.VarChar(50)   // INS_020: Good/Normal/Poor
  electrificationType        String?   @db.VarChar(100)  // INS_021: Concealed/Open Wiring/Industrial 3-phase
  plumbingType               String?   @db.VarChar(50)   // INS_022: Concealed/Open
  externalWallFinish         String?   @db.VarChar(100)  // INS_023: Sand-faced/Texture/Glass Facade/Acrylic
  roofType                   String?   @db.VarChar(100)  // INS_024: RCC Slab/AC Sheet/Mangalore Tile/Other
  doorType                   String?   @db.VarChar(100)  // INS_025: Wooden/Rolling Shutter/Glass/Steel/Safety
  windowType                 String?   @db.VarChar(100)  // INS_026: Aluminium/MS/UPVC/Wooden/Elevation Glass
  kitchenPlatformMaterial    String?   @db.VarChar(100)  // INS_027: Granite/Marble/Kadappa/SS/Nil
  wallFinishing              String?   @db.VarChar(100)  // UNIT_008: Painted/Texture/Tile/Bare
  ceilingHeightFt            Decimal?  @db.Decimal(5, 2) // UNIT_009: clear unit ceiling height in feet
  doorsWindowsType           String?   @db.VarChar(100)  // UNIT_010: legacy combined field
  electricalFittings         String?   @db.VarChar(100)  // UNIT_011: Standard/Good/Industrial/High Tension
  sanitaryFittings           String?   @db.VarChar(100)  // UNIT_012: Standard/Good/Imported
  acType                     String?   @db.VarChar(50)   // UNIT_013: Window/Split/Central/None
  leaseholdDetails           String?   @db.VarChar(500)  // UNIT_014: Canara Shop — Lessor/Lessee/Period

  // INS_028–032: Room/unit count details
  numberOfRooms              Int?                        // INS_028: rooms excl. kitchen & bath
  numberOfToilets            Int?                        // INS_029
  numberOfBalconies          Int?                        // INS_030
  numberOfTerraces           Int?                        // INS_031
  accommodationDescription   String?   @db.Text          // INS_032: full free-text e.g. "2BHK: Hall, 2 Beds..."

  // INS_033–044: UC Construction Stage Tracking (individual columns per decision)
  rccSlabCompleteFloor       String?   @db.VarChar(100)  // INS_033: e.g. "18th floor"
  brickworkCompleteFloor     String?   @db.VarChar(100)  // INS_034
  internalPlasterStatus      String?   @db.VarChar(30)   // INS_035: Completed/In Progress/Not Started
  externalPlasterStatus      String?   @db.VarChar(30)   // INS_036
  flooringWorkStatus         String?   @db.VarChar(30)   // INS_037
  woodworkStatus             String?   @db.VarChar(30)   // INS_038
  internalPaintingStatus     String?   @db.VarChar(30)   // INS_039
  externalPaintingStatus     String?   @db.VarChar(30)   // INS_040
  plumbingWorkStatus         String?   @db.VarChar(30)   // INS_041
  electrificationWorkStatus  String?   @db.VarChar(30)   // INS_042
  liftInstallationStatus     String?   @db.VarChar(30)   // INS_043: Installed/In Progress/Not Started
  finalFinishingStatus       String?   @db.VarChar(30)   // INS_044

  // INS_045–047: Inspector's market rate observations (internal, never published)
  observedRateCarpet         Decimal?  @db.Decimal(12, 2) // INS_045: Rs/Sq.Ft carpet
  observedRateSuba           Decimal?  @db.Decimal(12, 2) // INS_046: Rs/Sq.Ft SUBA
  inspectorValueEstimate     Decimal?  @db.Decimal(15, 2) // INS_047: rough lump-sum estimate

  // INS_048–050: Broker / Agent details
  brokerName                 String?   @db.VarChar(200)  // INS_048
  brokerPhone                String?   @db.VarChar(15)   // INS_049
  brokerFirmName             String?   @db.VarChar(200)  // INS_050

  // Neighbourhood
  neighborhoodType           String?   @db.VarChar(100)
  approachRoadWidth          String?   @db.VarChar(50)   // PHY_004 (also captured here by inspector)

  // Inspector's remarks
  observationRemarks         String?   @db.Text

  // AREA_001: Use of property as observed
  useOfProperty              String?   @db.VarChar(50)   // Residential/Commercial/Industrial/Mixed

  // BLDG_014: Parking
  parkingType                String?   @db.VarChar(100)  // Stilt/Open/Basement/Mechanical/None
  parkingCount               Int?

  // DOC_016: Documents seen at site
  documentsAvailableAtSite   Json?                       // string[] of doc type labels seen
  otherDocumentsNote         String?   @db.VarChar(500)  // DOC_019

  // UC_013: Internal access
  internalAccessAllowed      Boolean?                    // Was internal site access allowed?

  // Boundaries as observed at site (separate from document-derived boundaries in Property)
  observedBoundaries         Json?                       // {north,south,east,west,unitNorth,unitSouth,unitEast,unitWest}

  // Actual site measurements (measured during inspection, synced to Property)
  builtUpAreaActualSqM       Decimal?  @db.Decimal(12, 4)
  builtUpAreaActualSqFt      Decimal?  @db.Decimal(12, 4)
  carpetAreaActualSqM        Decimal?  @db.Decimal(12, 4)
  carpetAreaActualSqFt       Decimal?  @db.Decimal(12, 4)
  landAreaActualSqM          Decimal?  @db.Decimal(12, 4)
  landAreaActualSqFt         Decimal?  @db.Decimal(12, 4)

  // Completion
  isComplete                 Boolean   @default(false)
  submittedAt                DateTime?

  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([tenantId])
  @@index([inspectorId])
  @@map("inspections")
}
